"""Give the Optimization Pipeline one equation slide after each of its four.

WHY: the DSMC subsection of the deck explains its physics and then shows the
equation that governs it; the optimization subsection explains its four
steps but showed no equation. The thesis carries the design vector, the
composite cost, the operators of the genetic algorithm and the correction
factor of the second pass, so each of the four slides now gets its own
equation slide in the same shape.

The script is a guarded driver: it measures every title and every set of
cards before writing, counts every anchor, refuses to write a file that
carries an em dash, parses the result and leaves every file untouched when a
check fails.
"""

from __future__ import annotations

import ast
import json
import sys
from pathlib import Path
from typing import cast

PROJECT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PROJECT))

SPEC = PROJECT / "scaffold.json"
TESTS = PROJECT / "tests" / "test_make_pptx.py"
README = PROJECT / "README.md"
BACKUP_DIR = Path(__file__).resolve().parent / "backups"
SPEC_BACKUP = BACKUP_DIR / "scaffold_before_pipeline_equations.json"
TESTS_BACKUP = BACKUP_DIR / "test_make_pptx_before_pipeline_equations.py"
README_BACKUP = BACKUP_DIR / "README_before_pipeline_equations.md"
EM_DASH = "\u2014"
#: A picture below this size was not written by the renderer.
MIN_PICTURE_BYTES = 5000
SOURCE_LINE = "Source: typeset from chapter 3 of the thesis by tools/make_equation_pictures.py."
FOOTER = "The equation that governs the step. The narration stays editable in PowerPoint."
TITLE_BUDGET_IN = 8.165

