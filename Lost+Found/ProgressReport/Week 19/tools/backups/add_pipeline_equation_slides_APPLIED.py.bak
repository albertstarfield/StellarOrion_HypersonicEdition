def measure() -> list[str]:
    """Return every title and card set that does not fit.

    Returns:
        The problems found, empty when everything fits.
    """
    import make_pptx as maker  # ruff: ignore[import-outside-top-level]

    problems: list[str] = []
    for _after, _new_id, title, _caption, cards, _target, _note in SLIDES:
        width = maker.measure_text_inches(title, maker.TITLE_FONT, maker.FRAME_TITLE_SIZE.pt)
        if width > TITLE_BUDGET_IN:
            problems.append(f"the title {title!r} measures {width:.2f} in")
        plan = maker._side_points_plan(  # ruff: ignore[private-member-access]
            tuple(cards),
            maker.BODY_FONT,
            maker.SIDE_POINTS_COLUMN_MIN_IN,
            4.20,
        )
        if plan[0] != maker.SIDE_POINTS_TEXT_START_PT:
            problems.append(f"{title}: the cards need {plan[0]} pt")
    return problems


def slug(frame_id: str) -> str:
    """Return the picture key of an equation frame identifier.

    Args:
        frame_id: The identifier of the frame, for example
            recall-methodology-equation-pipeline-space.

    Returns:
        The key that names the picture of that frame.

    """
    return frame_id.rsplit("-", 1)[-1]


def build_frames() -> str:
    """Return the specification text with the four frames inserted.

    Returns:
        The new text of the specification.

    Raises:
        SystemExit: When an anchor is missing or the result would not fit.
    """
    document = json.loads(SPEC.read_text(encoding="utf-8"))
    frames = cast("list[dict[str, object]]", document["frames"])
    problems: list[str] = []
    for anchor, new_id, *_rest in SLIDES:
        if new_id in [str(frame.get("id")) for frame in frames]:
            problems.append(f"the frame '{new_id}' is already in the specification")
        if anchor not in [str(frame.get("id")) for frame in frames]:
            problems.append(f"the specification does not hold the frame '{anchor}'")
    if len(problems) != 0:
        for problem in problems:
            _ = sys.stdout.write(f"MISMATCH {problem}\n")
        raise SystemExit(1)
    for anchor, new_id, title, caption, cards, target, note in SLIDES:
        ids = [str(frame.get("id")) for frame in frames]
        position = ids.index(anchor) + 1
        body = "\n".join(f"- {card}" for card in cards)
        frames.insert(
            position,
            {
                "id": new_id,
                "section": "RECALL",
                "title": title,
                "body": body,
                "target_position": target,
                "note": note,
                "figure": {
                    "path": f"figures/thesis_equation_{PIPELINE_PIC[slug(new_id)]}.png",
                    "caption": caption,
                    "source": SOURCE_LINE,
                    "layout": "side_points",
                },
                "footer": FOOTER,
                "subsection": "Methodology: Optimization Pipeline",
            },
        )
    text = json.dumps(document, indent=2, ensure_ascii=False) + "\n"
    if EM_DASH in text:
        _ = sys.stdout.write("MISMATCH the specification would carry an em dash\n")
        raise SystemExit(1)
    return text


PIPELINE_PIC: dict[str, str] = {
    "space": "design_space",
    "cost": "cost_function",
    "ga": "ga",
    "gate": "double_pass",
}


def check_anchors() -> None:
    """Verify the counts of the anchors in the test suite and the README.

    Raises:
        SystemExit: When an anchor does not match its count.
    """
    problems: list[str] = []
    tests_text = TESTS.read_text(encoding="utf-8")
    for old, _new, expected in TEST_RULES:
        found = tests_text.count(old)
        if found != expected:
            problems.append(f"tests: expected {expected}, found {found}: {old[:50]!r}")
    readme_text = README.read_text(encoding="utf-8")
    for old, _new, expected in README_RULES:
        found = readme_text.count(old)
        if found != expected:
            problems.append(f"README: expected {expected}, found {found}: {old[:50]!r}")
    for _anchor, new_id, title, _caption, _cards, _target, _note in SLIDES:
        picture = PROJECT / "figures" / f"thesis_equation_{PIPELINE_PIC[slug(new_id)]}.png"
        if not picture.is_file() or picture.stat().st_size < MIN_PICTURE_BYTES:
            problems.append(f"the picture of {title} is missing or too small")
    if len(problems) != 0:
        for problem in problems:
            _ = sys.stdout.write(f"MISMATCH {problem}\n")
        raise SystemExit(1)


def apply_docs(spec_text: str) -> tuple[str, str]:
    """Return the new test file and README text.

    Args:
        spec_text: The new specification, used only for its em dash check.

    Returns:
        The new text of the test suite and of the README.

    Raises:
        SystemExit: When a file would carry an em dash or not parse.
    """
    del spec_text
    tests_text = TESTS.read_text(encoding="utf-8")
    for old, new, _expected in TEST_RULES:
        tests_text = tests_text.replace(old, new, 1)
    if EM_DASH in tests_text:
        _ = sys.stdout.write("MISMATCH the test file would carry an em dash\n")
        raise SystemExit(1)
    try:
        _ = ast.parse(tests_text)
    except SyntaxError as error:
        _ = sys.stdout.write(f"MISMATCH the test file would not parse: {error}\n")
        raise SystemExit(1) from error
    readme_text = README.read_text(encoding="utf-8")
    for old, new, _expected in README_RULES:
        readme_text = readme_text.replace(old, new, 1)
    if EM_DASH in readme_text:
        _ = sys.stdout.write("MISMATCH README.md would carry an em dash\n")
        raise SystemExit(1)
    return tests_text, readme_text


def main() -> int:
    """Insert the four frames, then update the tests and the README.

    Returns:
        Zero when every file was written, one when a guard refused.

    """
    problems = measure()
    if len(problems) != 0:
        for problem in problems:
            _ = sys.stdout.write(f"MISMATCH {problem}\n")
        return 1
    try:
        check_anchors()
        spec_text = build_frames()
        tests_text, readme_text = apply_docs(spec_text)
    except SystemExit as error:
        if error.code == 0:
            return 0
        return 1
    except (KeyError, TypeError, ValueError, OSError, json.JSONDecodeError) as error:
        _ = sys.stdout.write(f"MISMATCH {type(error).__name__}: {error}\n")
        return 1
    _ = BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    _ = SPEC_BACKUP.write_bytes(SPEC.read_bytes())
    _ = TESTS_BACKUP.write_bytes(TESTS.read_bytes())
    _ = README_BACKUP.write_bytes(README.read_bytes())
    _ = SPEC.write_text(spec_text, encoding="utf-8")
    _ = TESTS.write_text(tests_text, encoding="utf-8")
    _ = README.write_text(readme_text, encoding="utf-8")
    _ = sys.stdout.write("the four optimization equation slides are in the specification\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
