/-!
# gnatprove_exit_code.lean

Axiom test for this turn's logical claim:

  *The "no bodies have been selected" branch of gnatprove does not itself set
   `Error_Code := 1`, therefore the rc=1 we observed on
   `-u stellarorion_optimization.adb` cannot have originated in that branch and
   must come from outside it.*

The claim is only as good as the encoding of the source.  Encoding, taken from
`spark_report.adb:1442-1490` (fetched to `~/Downloads/spark_report.adb`):

    if not Has_Errors and then Mode not in Check|Check_All and then not Has_Check then
       if Has_Limit_Switches then
          Error_Code := 1;                                   -- :1458
          ... "error: no checks generated by GNATprove"
       elsif Verbosity /= Quiet_Level then
          ... "warning: no checks generated by GNATprove"     -- :1469
       end if;
    end if;

`Error_Code` is initialised to 0 and, in this block, assigned only under
`Has_Limit_Switches`.  Everything else in gnatprove that can set a non-zero code
(unproved checks, gnatprove errors) is a separate block, modelled here as
`Other_Code`.
-/

namespace ProveExit

/-- The part of the exit-code decision that the disputed block owns.
`limit` = `Has_Limit_Switches`, `checks` = `Has_Check`, `errs` = `Has_Errors`. -/
def Block_Code (limit checks errs : Bool) : Nat :=
  if !errs && !checks then (if limit then 1 else 0) else 0

/-- THE CLAIM: without `--limit-subp`/`--limit-line`, the block leaves the code at 0
even when it printed the "no bodies have been selected" warning -- warning and
error are not the same thing here. -/
theorem warning_branch_returns_zero (checks errs : Bool) :
    Block_Code false checks errs = 0 := by
  unfold Block_Code
  simp

/-- The branch that DOES return 1: restricted analysis with limit switches.  Stated
separately so the two cases cannot be conflated. -/
theorem limit_switch_branch_returns_one (errs : Bool) (h : errs = false) :
    Block_Code true false errs = 1 := by
  subst h
  unfold Block_Code
  simp

/-- If any checks were generated, this block is not even entered. -/
theorem no_block_entry_when_checks_exist (limit errs : Bool) :
    Block_Code limit true errs = 0 := by
  unfold Block_Code
  simp

/-- The whole observation, assembled: our invocation used `-u` and `--mode=all`
only, so `limit = false`; the run produced no checks, so `checks = false`; hence
the block's own contribution to the exit status is 0, and the observed rc=1 must
be attributed to `Other_Code`. -/
theorem observed_one_is_not_from_this_block :
    ¬ (Block_Code false false false = 1) := by
  rw [warning_branch_returns_zero]
  exact Nat.zero_ne_one

/-- Corollary in the form actually used in the report: with `limit = false`,
`Block_Code` cannot distinguish a proved run from a skipped run -- which is why the
warning, not the exit code, is the diagnostic that matters. -/
theorem exit_code_cannot_distinguish :
    Block_Code false false false = Block_Code false true false := by
  simp [Block_Code]

/-- Separately, the summary line we cited: `0 subprograms and packages out of 0
analyzed` is zero checks, not zero failures.  Encoding the two counts. -/
def Analysed (subprogs : Nat) (of_total : Nat) : Bool :=
  subprogs != 0 && subprogs ≤ of_total

theorem zero_of_zero_is_not_analysed : Analysed 0 0 = false := by
  unfold Analysed
  simp

/-- And the converse guard: the core's `183 of 183` does count as analysed, so the
two summary lines are genuinely different objects. -/
theorem core_is_analysed : Analysed 183 183 = true := by
  unfold Analysed
  simp

end ProveExit
