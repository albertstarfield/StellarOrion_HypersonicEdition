project StellarOrion_PINN_Lib is

   for Source_Dirs use ("src/simulation_engine");
   for Object_Dir use "obj";
   for Library_Name use "stellarorion_pinn";
   for Library_Dir use "lib";
   for Library_Kind use "Dynamic";
   --  Exclude main.adb (it has a procedure body, incompatible with library)
   for Source_Files use (
      "stellarorion_types.ads",
      "stellarorion_types.adb",
      "stellarorion_environment.ads",
      "stellarorion_environment.adb",
      "stellarorion_geometry.ads",
      "stellarorion_geometry.adb",
      "stellarorion_physics.ads",
      "stellarorion_physics.adb",
      "stellarorion_pinn_trajectory.ads",
      "stellarorion_pinn_trajectory.adb"
   );

   package Compiler is
      for Switches ("ada") use
        ("-gnat12",
         "-gnatwa",
         "-gnatW8",
         "-gnatQ",
         "-gnatdAME",
         "-fPIC");
   end Compiler;

   package Linker is
      for Switches ("ada") use
        ("-g",
         "-Wl,-syslibroot,/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk");
   end Linker;

end StellarOrion_PINN_Lib;
