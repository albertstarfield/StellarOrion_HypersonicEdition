project StellarOrion_PINN_Lib is

   for Source_Dirs use ("src/simulation_engine");
   for Object_Dir use "obj";
   for Library_Name use "stellarorion_pinn";
   for Library_Dir use "lib";
   for Library_Kind use "Dynamic";
   --  Exclude main.adb (it has a procedure body, incompatible with library)
   for Source_Files use (
      "stellarorion_types.ads",
      "stellarorion_types.adb",
      "stellarorion_environment.ads",
      "stellarorion_environment.adb",
      "stellarorion_geometry.ads",
      "stellarorion_geometry.adb",
      "stellarorion_physics.ads",
      "stellarorion_physics.adb",
      "stellarorion_pinn_trajectory.ads",
      "stellarorion_pinn_trajectory.adb",
      "stellarorion_trajectory_output.ads",    -- NEW: frame data computation for Python FFI
      "stellarorion_trajectory_output.adb",
      "stellarorion_pipeline_checkpoint.ads",  -- NEW: checkpoint state management for Python FFI
      "stellarorion_pipeline_checkpoint.adb",
       "stellarorion_optimization.ads",         -- NEW: MoP_Fitness/CCD/GA optimization for Python FFI
      "stellarorion_optimization.adb",
      "stellarorion_postprocessing.ads",       -- NEW: postprocessing analytics for Python FFI
      "stellarorion_postprocessing.adb",
      "stellarorion_ffi.ads",                  -- NEW: C-compatible FFI layer for Python ctypes
      "stellarorion_ffi.adb"
   );

   package Compiler is
      for Switches ("ada") use
        ("-gnat12",
         "-gnatwa",     --  All warnings
         "-gnatwe",     --  Warnings as errors  [NEW: warnings-as-errors enforcement]
         "-gnatW8",
         "-gnatQ",
         "-gnatdME",    --  -gnatdM: conservative flow (assume all vars
                        --  modified); -gnatdE: elab checks for predefined
                        --  units. -gnatdA removed: it breaks GNATprove
                        --  data-rep JSON (conflicting duplicates).
                        --  CITATION: gcc/ada/debug.adb (GNAT 16.1.0).
         "-fPIC");
   end Compiler;

   --  Platform-conditional linker flags (full rationale + AXIOMS in
   --  stellarorion_program_proc.gpr): macOS keeps the REQUIRED
   --  -Wl,-syslibroot switch; Termux/Linux (GNU ld) drops it because
   --  GNU ld rejects the Apple-specific flag. Detection: Termux exports
   --  PREFIX=/data/data/com.termux/files/usr; override with
   --  STELLARORION_HOST_OS=macos|termux.
   --  [Citation: GNAT Project Manager External()/case —
   --   https://docs.adacore.com/gprbuild-docs/html/gpr_build_ref/]
   Prefix_V := External ("PREFIX", "");
   Host_OS  := External ("STELLARORION_HOST_OS", "");

   case Host_OS is
      when "" =>
         Host_OS := "macos";
         case Prefix_V is
            when "/data/data/com.termux/files/usr" => Host_OS := "termux";
            when others => null;
         end case;
      when "macos" | "termux" => null;
      when others => Host_OS := "macos";
   end case;

   Linker_Extra := ();
   case Host_OS is
      when "macos" =>
         Linker_Extra :=
           ("-Wl,-syslibroot,/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk");
      when others =>
         null;   --  Termux/Linux GNU ld: no syslibroot (flag unsupported)
   end case;

   package Linker is
      for Switches ("ada") use
        ("-g") & Linker_Extra;
   end Linker;

end StellarOrion_PINN_Lib;
