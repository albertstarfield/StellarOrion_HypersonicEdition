# Auto detect text files and perform LF normalization
* text=auto

# Git LFS - compressed archives (original + split parts)
*.tar.zst filter=lfs diff=lfs merge=lfs -text
*.tar.zst.part_* filter=lfs diff=lfs merge=lfs -text

# Git LFS - large data / result files
*.csv filter=lfs diff=lfs merge=lfs -text

# Git LFS - large binaries (papers, meshes, media)
*.pdf filter=lfs diff=lfs merge=lfs -text
*.vtp filter=lfs diff=lfs merge=lfs -text
*.vtu filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
